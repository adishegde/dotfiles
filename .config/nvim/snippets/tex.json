      "$0"
    ]
  },
  {
    "prefix": "eq*",
    "body": [
      "\\begin{equation*}",
      "    ${1:equation}",
      "\\end{equation*}",
      "$0"
    ]
  },
  {
    "prefix": "ali",
    "body": [
      "\\begin{align}",
      "    ${1:left} &= ${2:right}",
      "\\end{align}",
      "$0"
    ]
  },
  {
    "prefix": "ali*",
    "body": [
      "\\begin{align*}",
      "    ${1:left} &= ${2:right}",
      "\\end{align*}",
      "$0"
    ]
  },
  {
    "prefix": "gat",
    "body": [
      "\\begin{gather}",
