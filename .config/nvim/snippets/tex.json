[
  {
    "prefix": "beg",
    "body": [
      "\\begin{${1:environment}}",
      "    ${2:content}",
      "\\end{$1}"
    ]
  },
  {
    "prefix": "eq",
    "body": [
      "\\begin{equation}",
      "    ${1:equation}",
      "\\end{equation}"
    ]
  },
  {
    "prefix": "eq*",
    "body": [
      "\\begin{equation*}",
      "    ${1:equation}",
      "\\end{equation*}"
    ]
  },
  {
    "prefix": "ali",
    "body": [
      "\\begin{align}",
      "    ${1:left} &= ${2:right}",
      "\\end{align}"
    ]
  },
  {
    "prefix": "ali*",
    "body": [
      "\\begin{align*}",
      "    ${1:left} &= ${2:right}",
      "\\end{align*}"
    ]
  },
  {
    "prefix": "gat",
    "body": [
      "\\begin{gather}",
      "    ${1:expression}",
      "\\end{gather}"
    ]
  },
  {
    "prefix": "gat*",
    "body": [
      "\\begin{gather*}",
      "    ${1:expression}",
      "\\end{gather*}"
    ]
  },
  {
    "prefix": "item",
    "body": [
      "\\begin{itemize}",
      "    \\item ${1:item}",
      "\\end{itemize}"
    ]
  },
  {
    "prefix": "enum",
    "body": [
      "\\begin{enumerate}",
      "    \\item ${1:item}",
      "\\end{enumerate}"
    ]
  },
  {
    "prefix": "fig",
    "body": [
      "\\begin{figure}[${1:htbp}]",
      "    \\centering",
      "    \\includegraphics[width=${2:\\linewidth}]{${3:path}}",
      "    \\caption{${4:caption}}",
      "    \\label{fig:${5:label}}",
      "\\end{figure}"
    ]
  },
  {
    "prefix": "array",
    "body": [
      "\\begin{array}{${1:c}}",
      "    ${2:entries}",
      "\\end{array}"
    ]
  }
]
